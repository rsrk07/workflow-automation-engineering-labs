{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "5.40.0"
  },
  "schemaVersion": 16,
  "id": "warden-approval-form",
  "type": "default",
  "components": [
    {
      "text": "### Hostel out-pass request\n\n**Student:** {{studentName}} ({{regNo}})\n\n**Hostel block:** {{hostelBlock}}\n\n**Out date:** {{outDate}}\n\n**Return date:** {{returnDate}}\n\n**Nights:** {{nights}}\n\n**Purpose:** {{purpose}}\n\n**Parent phone:** {{parentPhone}}",
      "type": "text",
      "id": "Field_RequestSummary",
      "layout": { "row": "Row_Summary" }
    },
    {
      "label": "Approve this out-pass",
      "type": "checkbox",
      "id": "Field_Approved",
      "key": "approved",
      "defaultValue": false,
      "layout": { "row": "Row_Decision" }
    },
    {
      "label": "Warden remarks",
      "type": "textarea",
      "id": "Field_WardenRemarks",
      "key": "wardenRemarks",
      "layout": { "row": "Row_Remarks" }
    }
  ]
}
