<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_HospitalBooking"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.40.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="hospital-appointment-booking" name="Hospital Appointment Booking" isExecutable="true">
    <bpmn:documentation>Start variables: patientId, patientName, department, preferredSlot, bookedCount, telegramChatId. The patient can cancel at any time by publishing the message "cancel-booking" with correlation key = patientId.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_BookingRequested" name="Booking requested">
      <bpmn:outgoing>Flow_ToCheckSlot</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_CheckSlot" name="Check slot">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheckSlot</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSlotGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_SlotAvailable" name="Slot available?">
      <bpmn:incoming>Flow_ToSlotGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Available</bpmn:outgoing>
      <bpmn:outgoing>Flow_Full</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_BookSlot" name="Book slot">
      <bpmn:extensionElements>
        <zeebe:script expression="={bookingId: &#34;BK-&#34; + patientId, status: &#34;BOOKED&#34;, slot: preferredSlot}" resultVariable="booking" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendConfirmation</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="Call_SendConfirmation" name="Send booking confirmation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=telegramChatId" target="recipientId" />
          <zeebe:input source="=&#34;Hello &#34; + patientName + &#34;, your &#34; + department + &#34; appointment on &#34; + preferredSlot + &#34; is confirmed. Booking ID: &#34; + booking.bookingId" target="messageText" />
          <zeebe:output source="=notificationSent" target="confirmationSent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWaitAppointment</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="Timer_WaitAppointment" name="Wait until appointment (10 min demo)">
      <bpmn:incoming>Flow_ToWaitAppointment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAppointmentDone</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_WaitAppointment">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_AppointmentDone" name="Appointment completed">
      <bpmn:incoming>Flow_ToAppointmentDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_SendSlotFull" name="Send slot-full notice">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=telegramChatId" target="recipientId" />
          <zeebe:input source="=&#34;Sorry &#34; + patientName + &#34;, the &#34; + department + &#34; slot on &#34; + preferredSlot + &#34; is full. &#34; + slotResult.suggestedAction + &#34;.&#34;" target="messageText" />
          <zeebe:output source="=notificationSent" target="slotFullNoticeSent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Full</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotBooked</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_NotBooked" name="Slot full - not booked">
      <bpmn:incoming>Flow_ToNotBooked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCheckSlot" sourceRef="StartEvent_BookingRequested" targetRef="Task_CheckSlot" />
    <bpmn:sequenceFlow id="Flow_ToSlotGateway" sourceRef="Task_CheckSlot" targetRef="Gateway_SlotAvailable" />
    <bpmn:sequenceFlow id="Flow_Available" name="AVAILABLE" sourceRef="Gateway_SlotAvailable" targetRef="Task_BookSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotResult.slotStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Full" name="FULL" sourceRef="Gateway_SlotAvailable" targetRef="Call_SendSlotFull">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotResult.slotStatus = "FULL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToSendConfirmation" sourceRef="Task_BookSlot" targetRef="Call_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_ToWaitAppointment" sourceRef="Call_SendConfirmation" targetRef="Timer_WaitAppointment" />
    <bpmn:sequenceFlow id="Flow_ToAppointmentDone" sourceRef="Timer_WaitAppointment" targetRef="EndEvent_AppointmentDone" />
    <bpmn:sequenceFlow id="Flow_ToNotBooked" sourceRef="Call_SendSlotFull" targetRef="EndEvent_NotBooked" />
    <bpmn:subProcess id="SubProcess_HandleCancellation" name="Handle cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_CancellationRequested" name="Cancellation requested" isInterrupting="true">
        <bpmn:outgoing>Flow_ToReleaseSlot</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_Cancel" messageRef="Message_CancelBooking" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_ReleaseSlot" name="Release slot">
        <bpmn:extensionElements>
          <zeebe:script expression="={slotReleased: true, releasedSlot: preferredSlot, releasedAt: string(now())}" resultVariable="cancellation" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToReleaseSlot</bpmn:incoming>
        <bpmn:outgoing>Flow_ToSendCancellation</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="Call_SendCancellation" name="Send cancellation notice">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=telegramChatId" target="recipientId" />
            <zeebe:input source="=&#34;Hello &#34; + patientName + &#34;, your &#34; + department + &#34; appointment on &#34; + preferredSlot + &#34; has been cancelled and the slot has been released.&#34;" target="messageText" />
            <zeebe:output source="=notificationSent" target="cancellationNoticeSent" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToSendCancellation</bpmn:incoming>
        <bpmn:outgoing>Flow_ToBookingCancelled</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="EndEvent_BookingCancelled" name="Booking cancelled">
        <bpmn:incoming>Flow_ToBookingCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToReleaseSlot" sourceRef="StartEvent_CancellationRequested" targetRef="Task_ReleaseSlot" />
      <bpmn:sequenceFlow id="Flow_ToSendCancellation" sourceRef="Task_ReleaseSlot" targetRef="Call_SendCancellation" />
      <bpmn:sequenceFlow id="Flow_ToBookingCancelled" sourceRef="Call_SendCancellation" targetRef="EndEvent_BookingCancelled" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_CancelBooking" name="cancel-booking">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HospitalBooking">
    <bpmndi:BPMNPlane id="BPMNPlane_HospitalBooking" bpmnElement="hospital-appointment-booking">
      <bpmndi:BPMNShape id="StartEvent_BookingRequested_di" bpmnElement="StartEvent_BookingRequested">
        <dc:Bounds x="172" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="146" y="225" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSlot_di" bpmnElement="Task_CheckSlot">
        <dc:Bounds x="260" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SlotAvailable_di" bpmnElement="Gateway_SlotAvailable" isMarkerVisible="true">
        <dc:Bounds x="405" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="395" y="145" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BookSlot_di" bpmnElement="Task_BookSlot">
        <dc:Bounds x="530" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SendConfirmation_di" bpmnElement="Call_SendConfirmation">
        <dc:Bounds x="690" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_WaitAppointment_di" bpmnElement="Timer_WaitAppointment">
        <dc:Bounds x="852" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="822" y="225" width="96" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_AppointmentDone_di" bpmnElement="EndEvent_AppointmentDone">
        <dc:Bounds x="962" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="943" y="225" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SendSlotFull_di" bpmnElement="Call_SendSlotFull">
        <dc:Bounds x="530" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_NotBooked_di" bpmnElement="EndEvent_NotBooked">
        <dc:Bounds x="692" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="668" y="355" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCheckSlot_di" bpmnElement="Flow_ToCheckSlot">
        <di:waypoint x="208" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSlotGateway_di" bpmnElement="Flow_ToSlotGateway">
        <di:waypoint x="360" y="200" />
        <di:waypoint x="405" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Available_di" bpmnElement="Flow_Available">
        <di:waypoint x="455" y="200" />
        <di:waypoint x="530" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="463" y="182" width="58" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Full_di" bpmnElement="Flow_Full">
        <di:waypoint x="430" y="225" />
        <di:waypoint x="430" y="330" />
        <di:waypoint x="530" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="442" y="273" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSendConfirmation_di" bpmnElement="Flow_ToSendConfirmation">
        <di:waypoint x="630" y="200" />
        <di:waypoint x="690" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWaitAppointment_di" bpmnElement="Flow_ToWaitAppointment">
        <di:waypoint x="790" y="200" />
        <di:waypoint x="852" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAppointmentDone_di" bpmnElement="Flow_ToAppointmentDone">
        <di:waypoint x="888" y="200" />
        <di:waypoint x="962" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNotBooked_di" bpmnElement="Flow_ToNotBooked">
        <di:waypoint x="630" y="330" />
        <di:waypoint x="692" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="SubProcess_HandleCancellation_di" bpmnElement="SubProcess_HandleCancellation" isExpanded="true">
        <dc:Bounds x="260" y="420" width="560" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_CancellationRequested_di" bpmnElement="StartEvent_CancellationRequested">
        <dc:Bounds x="292" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="535" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReleaseSlot_di" bpmnElement="Task_ReleaseSlot">
        <dc:Bounds x="390" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SendCancellation_di" bpmnElement="Call_SendCancellation">
        <dc:Bounds x="550" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_BookingCancelled_di" bpmnElement="EndEvent_BookingCancelled">
        <dc:Bounds x="722" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="696" y="535" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToReleaseSlot_di" bpmnElement="Flow_ToReleaseSlot">
        <di:waypoint x="328" y="510" />
        <di:waypoint x="390" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSendCancellation_di" bpmnElement="Flow_ToSendCancellation">
        <di:waypoint x="490" y="510" />
        <di:waypoint x="550" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToBookingCancelled_di" bpmnElement="Flow_ToBookingCancelled">
        <di:waypoint x="650" y="510" />
        <di:waypoint x="722" y="510" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
